---
// MainNav.astro
---

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".main-nav a");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        if (!isIntersecting) return;
        navLinks.forEach((l) => l.classList.remove("is-active"));
        if (target.id === "hero") return;
        const link = document.querySelector<HTMLAnchorElement>(
          `.main-nav a[href="/#${target.id}"]`
        );
        if (link) link.classList.add("is-active");
      });
    },
    { rootMargin: "0px 0px -50% 0px", threshold: 0 }
  );

  document
    .querySelectorAll<HTMLElement>("section[id]")
    .forEach((section) => observer.observe(section));
</script>

<nav class="main-nav box-shadow">
  <ul>
    <li><a href="/#hero">Home</a></li>
    <li><a href="/#bikes">Bikes</a></li>
    <li><a href="/#about">About</a></li>
  </ul>
</nav>

<style lang="scss">
  :global(.main-nav) {
    width: fit-content;
    padding: 0 0.5em;
    background: var(--nav-bg, var(--white));
    translate: var(--nav-translate, none);
    transition:
      translate 300ms ease,
      background 300ms ease;
    justify-self: center;
    border-radius: 8px;
    position: relative;
    z-index: 100;

    ul {
      padding: 0;
      margin: 0;
      list-style: none;
      display: flex;
    }

    a {
      display: block;
      padding: 0.5em;
      text-decoration: none;
      color: var(--black);
      font-weight: 600;
      position: relative;
      z-index: 2;
      transition: color 150ms;
      transition-delay: 250ms;
    }
  }
</style>
<style is:inline>
  @supports (anchor-scope: --anchor) {
    .main-nav ul {
      anchor-name: --nav-link;
    }
    .main-nav::after {
      content: "";
      position: absolute;
      position-anchor: --nav-link;
      inset-block-start: calc(anchor(end) - 12px);
      inset-inline-start: anchor(start);
      inset-inline-end: anchor(end);
      inset-block-end: calc(anchor(end) + 4);
      block-size: 6px;
      background-color: var(--teal);
      border-radius: 2px;
      opacity: 0.2;
      transition:
        background-color 0.4s,
        block-size 0.4s,
        opacity 0.4s,
        inset 0.4s,
        inset-inline 0.4s 0.5s;
      z-index: 1;
    }
    .main-nav a.is-active {
      anchor-name: --nav-link;
    }
    .main-nav:has(a.is-active)::after, .main-nav:has(a:hover)::after {
      block-size: auto;
      /* inset-block-start: anchor(start); */
      inset-inline-start: anchor(start);
      inset-inline-end: anchor(end);
      inset-block-end: calc(anchor(end) + 4px);
      transition: 250ms;
      opacity: 1;
    }
    .main-nav a:hover {
      anchor-name: --nav-link;
    }
  }
</style>